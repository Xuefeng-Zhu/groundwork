# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# ---------------------------------------------------------------------------
# Meeting Brief Agent
# ---------------------------------------------------------------------------
# Demo mode: deterministic fictional fixtures, no keys needed.
MOCK=1

# Tavily search (https://app.tavily.com). Required when MOCK is off.
TAVILY_API_KEY=
# How many top sources to enrich with Tavily Extract (0 disables).
TAVILY_EXTRACT_TOP=4

# Bifrost LLM gateway (https://github.com/maximhq/bifrost), OpenAI-compatible.
#   docker run -p 8080:8080 maximhq/bifrost   -> open http://localhost:8080 to add provider keys
BIFROST_URL=http://localhost:8080/v1
# Bifrost model ids are "<provider>/<model>".
BIFROST_MODEL=openai/gpt-4o-mini
# Optional Bifrost virtual key (sent as x-bf-vk).
BIFROST_API_KEY=

# Fallbacks used only if Bifrost is unset or fails.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_MS=60000
# Prompt budget. For Groq free tier (BIFROST_MODEL=groq/openai/gpt-oss-120b) use 12 and 450.
LLM_MAX_SOURCES=30
LLM_SOURCE_CHARS=1400

# Route the built-in agent chat through Bifrost too (framework reads these):
# OPENAI_BASE_URL=http://localhost:8080/v1
# (and set OPENAI_API_KEY to any non-empty value if Bifrost holds the real keys)

# Local dev without sign-in:
AUTH_DISABLED=true
